# LendFlow Namibia - Environment Variables
# =========================================

# API Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://your-frontend-url.com

# Database (Railway PostgreSQL)
# Get these from Railway dashboard → PostgreSQL service → Connection Info
DATABASE_URL=postgresql://postgres:your-password@your-host.railway.app:5432/lendflow

# Redis (Railway Redis)
# Get this from Railway dashboard → Redis service → Connection Info
REDIS_URL=redis://default:your-password@your-host.railway.app:6379

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-char-random-secret-here
JWT_REFRESH_SECRET=your-32-char-refresh-secret-here

# Twilio (SMS/WhatsApp)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+1xxxxxxxxxx

# Cloudflare R2 (Document Storage)
# Get these from Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=lendflow-documents

# Sentry (Error Tracking - Optional)
SENTRY_DSN=https://xxxx@sentry.io/xxxxx

# Resend (Transactional Email - Optional)
RESEND_API_KEY=re_xxxxx